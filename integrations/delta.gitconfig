# Generated by scripts/generate-integrations.py; do not edit directly.
# Include this file from ~/.gitconfig instead of replacing Git settings.

[delta]
    features = mooni-dark

[delta "mooni-dark"]
    syntax-theme = ansi
    plus-style = "#A8C486" "#1C1D19"
    minus-style = "#E89189" "#1C1D19"
    zero-style = syntax normal
    file-style = "#E8BD59" bold
    hunk-header-style = "#86C5B5" italic
    line-numbers = true
    line-numbers-minus-style = "#E89189"
    line-numbers-plus-style = "#A8C486"
